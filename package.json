{
  "name": "pi-vscode",
  "displayName": "Pi",
  "description": "VS Code extension for the pi coding agent — sidebar chat while you code",
  "version": "0.0.1",
  "publisher": "pi-vscode-dev",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hex4C59/pi-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Hex4C59/pi-vscode/issues"
  },
  "homepage": "https://github.com/Hex4C59/pi-vscode#readme",
  "keywords": [
    "vscode",
    "vscode-extension",
    "pi",
    "coding-agent",
    "sidebar"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:pi-vscode.chat"],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Shows workspace status and native trust management only. Project resource choices require a trusted workspace; pi runtime is not started."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pi-vscode",
          "title": "Pi",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "pi-vscode": [
        {
          "type": "webview",
          "id": "pi-vscode.chat",
          "name": "Chat",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "pi-vscode.focusChat",
        "title": "pi: Focus Chat",
        "category": "pi",
        "icon": {
          "light": "media/pi-light.svg",
          "dark": "media/pi-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-vscode.focusChat",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs && tsc --noEmit",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/extension/*.test.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist/tests && node --test dist/tests/*.test.js scripts/docs-i18n-check.test.mjs scripts/docs-verify.test.mjs scripts/docs-health.test.mjs scripts/project-trust.test.mjs",
    "spike:project-trust": "node scripts/spike-project-trust.mjs",
    "spike:runtime": "npm run compile && node dist/spike-runtime.js",
    "docs:i18n:check": "node scripts/docs-i18n-check.mjs",
    "docs:verify": "node scripts/docs-verify.mjs",
    "docs:health": "node scripts/docs-health.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  }
}
