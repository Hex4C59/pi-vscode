{
  "name": "pi-vscode",
  "displayName": "Pi",
  "description": "VS Code extension for the pi coding agent — sidebar chat while you code",
  "version": "0.0.1",
  "publisher": "pi-vscode-dev",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hex4C59/pi-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Hex4C59/pi-vscode/issues"
  },
  "homepage": "https://github.com/Hex4C59/pi-vscode#readme",
  "keywords": [
    "vscode",
    "vscode-extension",
    "pi",
    "coding-agent",
    "sidebar"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.19.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:pi-vscode.chat"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/approval-gate.mjs",
    "dist/session-worker.mjs",
    "dist/webview/**",
    "assets",
    "LICENSE",
    "node_modules/**"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Shows workspace status and native trust management only. Project resource choices require a trusted workspace; pi runtime is not started."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pi-vscode",
          "title": "Pi",
          "icon": "assets/pi.svg"
        }
      ]
    },
    "views": {
      "pi-vscode": [
        {
          "type": "webview",
          "id": "pi-vscode.chat",
          "name": "Chat",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "pi-vscode.focusChat",
        "title": "pi: Focus Chat",
        "category": "pi",
        "icon": {
          "light": "assets/pi-light.svg",
          "dark": "assets/pi-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-vscode.focusChat",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.tests.json",
    "watch": "node esbuild.mjs --watch",
    "build:webview": "vite build --config vite.config.mts",
    "preview:webview": "vite --config vite.config.mts",
    "verify:webview": "node scripts/packaging/verify-webview-assets.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node scripts/testing/run-tests.mjs",
    "commit:check": "node scripts/testing/commit-check.mjs",
    "spike:offline-inference": "node scripts/spikes/spike-offline-inference.mjs",
    "spike:approval": "npm run compile && node scripts/spikes/spike-approval.mjs",
    "spike:project-trust": "node scripts/spikes/spike-project-trust.mjs",
    "spike:runtime": "npm run compile && node dist/spike-runtime.js",
    "docs:i18n:check": "node scripts/docs/docs-i18n-check.mjs",
    "docs:verify": "node scripts/docs/docs-verify.mjs",
    "docs:health": "node scripts/docs/docs-health.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "^22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "jsdom": "28.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "7.3.1"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1"
  }
}
