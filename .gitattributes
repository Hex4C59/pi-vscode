# Keep repository text deterministic across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows command scripts require CRLF for native tooling.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply line-ending conversion to binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
