{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "--new-window",
        "--folder-uri=file://${workspaceFolder}/",
        "--user-data-dir=/tmp/pi-vscode-debug-isolated"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "Attach to Pi Extension Host",
      "type": "extensionHost",
      "request": "attach",
      "port": 9333,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
